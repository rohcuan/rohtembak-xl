# RohTembak (XL) - configuration template
# Copy to `.env` and fill in your own credentials. Never commit `.env`.

# --- XL API ---
BASE_API_URL=
BASE_CIAM_URL=
BASIC_AUTH=
AX_DEVICE_ID=
AX_FP_KEY=
UA=

# --- Encryption keys (must match the XL app values) ---
API_KEY=
AES_KEY_ASCII=
ENCRYPTED_FIELD_KEY=
XDATA_KEY=
AX_API_SIG_KEY=
X_API_BASE_SECRET=
CIRCLE_MSISDN_KEY=

# --- App ---
JWT_SECRET=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15

# --- Concurrency / throttling ---
API_DELAY=0.5
XL_CALL_LIMIT=6

# --- Database ---
DATABASE_URL=sqlite:///./data/me-cli-web.db
